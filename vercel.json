{
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/github-contributions",
      "destination": "/api/github-contributions"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
